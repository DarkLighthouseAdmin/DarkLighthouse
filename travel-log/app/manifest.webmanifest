{
  "name": "Famstamp",
  "short_name": "Famstamp",
  "description": "Stamp every trip. Color in every state, country and national park your family visits, from the first road trip on. Saved on your device.",
  "id": "/travel-log/app/",
  "start_url": "/travel-log/app/",
  "scope": "/travel-log/app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f3ea",
  "theme_color": "#16283a",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
